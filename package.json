{
  "name": "sci-motion-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:angles": "esbuild tests/synthetic.ts --bundle --platform=node --outfile=node_modules/.cache/synthetic.cjs --log-level=warning && node node_modules/.cache/synthetic.cjs",
    "test:sides": "esbuild tests/sideTracker.test.ts --bundle --platform=node --outfile=node_modules/.cache/sides.cjs --log-level=warning && node node_modules/.cache/sides.cjs",
    "test": "npm run test:angles && npm run test:sides && npm run test:live",
    "docs:angles": "esbuild scripts/gen-angle-docs.ts --bundle --platform=node --outfile=node_modules/.cache/gen-docs.cjs --log-level=warning && node node_modules/.cache/gen-docs.cjs",
    "test:live": "esbuild tests/liveDetector.test.ts --bundle --platform=node --outfile=node_modules/.cache/live.cjs --log-level=warning && node node_modules/.cache/live.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
